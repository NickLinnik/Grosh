# TimescaleDB
POSTGRES_USER=grosh
# REQUIRED: replace with a strong password before running
POSTGRES_PASSWORD=changeme
POSTGRES_DB=grosh

# ngrok (dev only — exposes webhook endpoint to the internet for bank webhooks)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-static-domain.ngrok-free.dev

# Infisical (production secrets manager)
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=

# Ingestion service
# Public URL where banks can reach the ingestion service webhook endpoint
WEBHOOK_BASE_URL=https://your-tunnel-or-domain.example.com
# Docker image used for K8s backfill jobs (set by `make k8s-setup` for local dev)
INGESTION_IMAGE=grosh-ingestion:latest

# Auth & Encryption
# HMAC secret used to sign and verify JWT access tokens — must be at least 32 characters
JWT_SECRET=changeme-replace-with-a-random-32-char-string
# Symmetric key for pgcrypto encryption of sensitive data at rest (bank tokens, etc.) — generate with: openssl rand -hex 32
ENCRYPTION_KEY=changeme-replace-with-a-random-hex-string
# PostgreSQL connection string for FastAPI and Alembic — use postgresql:// or postgresql+asyncpg://
DATABASE_URL=postgresql://grosh:changeme@timescaledb:5432/grosh
# Kafka broker address (Docker Compose uses 'redpanda:9092'; k8s-setup.sh substitutes to host.docker.internal:19092)
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# Email for the initial admin account created by the database seed script
ADMIN_EMAIL=admin@grosh.dev
# Password for the initial admin account — change before deploying
ADMIN_PASSWORD=changeme
